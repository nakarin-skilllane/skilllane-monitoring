{
  "name": "skilllane-monitoring",
  "private": true,
  "description": "SkillLane Monitoring: the SDK and wire contract services install to send logs and traces to a skilllane-monitoring engine",
  "packageManager": "pnpm@8.14.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/monitoring-contract --filter ./packages/monitoring build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check --no-errors-on-unmatched --diagnostic-level=error",
    "lint:fix": "biome check --write --no-errors-on-unmatched --diagnostic-level=error"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3"
  }
}
